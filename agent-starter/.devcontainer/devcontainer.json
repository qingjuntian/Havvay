{
  "name": "agent-starter",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.yml"
  ],
  "service": "web",
  "workspaceFolder": "/app",
  "shutdownAction": "stopCompose",
  "runServices": ["web", "qdrant"],
  "forwardPorts": [8000, 5678, 6333],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  }
}
